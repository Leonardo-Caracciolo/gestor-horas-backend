# ═══════════════════════════════════════════════════════════
#  Gestor de Horas — .gitignore
# ═══════════════════════════════════════════════════════════

# ── Variables de entorno (NUNCA subir al repo) ───────────────
.env
.env.local
.env.*.local
.env.production
.env.development.local

# ═══════════════════════════════════════════════════════════
#  BACKEND (Python)
# ═══════════════════════════════════════════════════════════

# ── Entorno virtual ─────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Python ───────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pyc
*.pycache

# ── Build / distribución ─────────────────────────────────────
dist/
build/
*.egg-info/
*.egg
MANIFEST
wheels/

# ── Testing y coverage ───────────────────────────────────────
.pytest_cache/
.coverage
.coverage.*
coverage.xml
*.coveragerc
results/
htmlcov/
nosetests.xml
junit*.xml

# ── MyPy / Pyright ───────────────────────────────────────────
.mypy_cache/
.dmypy.json
dmypy.json
.pyright/
.ruff_cache/

# ── Alembic ───────────────────────────────────────────────────
# Mantener versions/ pero ignorar archivos temporales
alembic/versions/*.pyc

# ── PyInstaller / PyWebView (Fase 7) ─────────────────────────
*.spec
*.exe
*.app

# ── Robot Framework ──────────────────────────────────────────
robot_results/
output.xml
log.html
report.html

# ═══════════════════════════════════════════════════════════
#  FRONTEND (Node / Vite / React)
# ═══════════════════════════════════════════════════════════

# ── Dependencias ─────────────────────────────────────────────
node_modules/
frontend/node_modules/
.pnp/
.pnp.js
.yarn/cache/
.yarn/unplugged/
.yarn/build-state.yml
.yarn/install-state.gz

# ── Build de Vite ────────────────────────────────────────────
frontend/dist/
frontend/dist-ssr/
frontend/.vite/
frontend/build/

# ── Logs de npm/yarn/pnpm ────────────────────────────────────
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ── Caché de herramientas frontend ───────────────────────────
.eslintcache
.stylelintcache
.parcel-cache/

# ── Archivos locales (no específicos por usuario) ────────────
*.local

# ═══════════════════════════════════════════════════════════
#  IDEs y editores
# ═══════════════════════════════════════════════════════════

# ── VS Code ──────────────────────────────────────────────────
.vscode/settings.json
.vscode/launch.json
.vscode/tasks.json
.vscode/*.code-snippets
# Si usan extensiones recomendadas grupales, descomentar:
# !.vscode/extensions.json
# !.vscode/launch.json

# ── JetBrains (PyCharm, WebStorm) ────────────────────────────
.idea/
*.iml
*.iws
*.ipr

# ── Vim / Emacs / Sublime ────────────────────────────────────
*.swp
*.swo
*~
\#*\#
.\#*
*.sublime-workspace
*.sublime-project

# ═══════════════════════════════════════════════════════════
#  Sistema operativo
# ═══════════════════════════════════════════════════════════

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*

# ═══════════════════════════════════════════════════════════
#  Archivos generados por la app o devs
# ═══════════════════════════════════════════════════════════

# ── Logs ─────────────────────────────────────────────────────
*.log
logs/

# ── Excel generados (export) ─────────────────────────────────
*.xlsx
*.zip
# Si tenés algún xlsx que SÍ querés versionar (ej. plantilla), descomentar:
# !templates/*.xlsx
# !docs/*.xlsx

# ── Bases de datos locales (SQLite, etc) ─────────────────────
*.db
*.sqlite
*.sqlite3

# ── Backups y temporales ─────────────────────────────────────
*.bak
*.tmp
*.swp
*~